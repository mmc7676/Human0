// PREVIEW deploy of the Claude-domain branch: own Worker name, workers.dev only, no custom domain or maxey0.com routes.
// Deploy:  npx wrangler deploy -c wrangler.preview.jsonc
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maxey0-context-plane-preview",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // /docs and /research are static files (built by tools/site/build_site.py); the Worker runs first for every other path.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    // Origins allowed when a request carries an Origin header (DNS-rebinding guard).
    // Requests without Origin (server-to-server MCP clients) are accepted.
    "ALLOWED_ORIGINS": "https://claude.ai,https://claude.com"
  },
  // Dense second signal: bge-m3 embeddings from Workers AI (free daily allocation covers this server's use);
  // node embeddings are kept in KV per graph digest (see src/dense.ts).
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "DENSE", "id": "edaf26bace7f4a56b7eb466da83a9a21" }],
  // Served on Human0's own domain as well as workers.dev (the connector, plugin and paper keep using workers.dev).
    "workers_dev": true,
  "observability": { "enabled": true }
  // Local tests without Cloudflare credentials use wrangler.local.jsonc (no AI / KV binding: TF-IDF only):
  // npx wrangler dev -c wrangler.local.jsonc --port 8794
}
