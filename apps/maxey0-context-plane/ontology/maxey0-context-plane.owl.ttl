@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://maxey0-context-plane-mcp.maxey0.workers.dev/owl> a owl:Ontology ;
    rdfs:comment "OWL 2 form of the Maxey0 Context Plane: Domain > Topic > Concept > Skill > MaxeyN Agent > MCP server." ;
    owl:versionInfo "maxey0.scw1-graph/3 sha256:e195205d526479231fbd64dbe47689b6d576edf924705c5541d099868b6f7aca (server 6.3.0)" .

mx:aObs a owl:DatatypeProperty ;
    rdfs:domain mx:DriftSCW ;
    rdfs:range xsd:decimal .

mx:aboutNode a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain mx:DriftSCW ;
    rdfs:range owl:Thing .

mx:basis a owl:DatatypeProperty ;
    rdfs:domain mx:Gate ;
    rdfs:range xsd:string .

mx:candidates a owl:DatatypeProperty ;
    rdfs:domain mx:LevelSCW ;
    rdfs:range xsd:integer .

mx:digest a owl:DatatypeProperty ;
    rdfs:domain mx:PathSCW ;
    rdfs:range xsd:string .

mx:distance a owl:DatatypeProperty ;
    rdfs:domain mx:DriftSCW ;
    rdfs:range xsd:decimal .

mx:drift a owl:DatatypeProperty ;
    rdfs:domain mx:DriftSCW ;
    rdfs:range xsd:decimal .

mx:explained a owl:DatatypeProperty ;
    rdfs:domain mx:LevelSCW ;
    rdfs:range xsd:decimal .

mx:fieldX a owl:DatatypeProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:decimal .

mx:fieldY a owl:DatatypeProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:decimal .

mx:fieldZ a owl:DatatypeProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:decimal .

mx:flat a owl:DatatypeProperty ;
    rdfs:domain mx:DriftSCW ;
    rdfs:range xsd:decimal .

mx:flatRank a owl:DatatypeProperty ;
    rdfs:domain mx:DriftSCW ;
    rdfs:range xsd:integer .

mx:gateAgent a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain mx:Gate ;
    rdfs:range mx:Agent .

mx:gateServer a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain mx:Gate ;
    rdfs:range mx:MCPServer .

mx:gateTopic a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain mx:Gate ;
    rdfs:range mx:Topic .

mx:hasConcept a owl:ObjectProperty ;
    owl:inverseOf mx:inTopic .

mx:hasDriftNode a owl:ObjectProperty ;
    rdfs:domain mx:LevelSCW ;
    rdfs:range mx:DriftSCW .

mx:hasLevel a owl:ObjectProperty ;
    rdfs:domain mx:PathSCW ;
    rdfs:range mx:LevelSCW .

mx:hasSkill a owl:ObjectProperty ;
    owl:inverseOf mx:inConcept .

mx:hasSupportAgent a owl:ObjectProperty ;
    rdfs:domain mx:Skill ;
    rdfs:range mx:Agent ;
    rdfs:subPropertyOf mx:hasAgent .

mx:hasTopic a owl:ObjectProperty ;
    owl:inverseOf mx:inDomain .

mx:heldBy a owl:ObjectProperty ;
    owl:inverseOf mx:holdsServer .

mx:key a owl:DatatypeProperty ;
    rdfs:domain mx:Agent ;
    rdfs:range xsd:string .

mx:keyword a owl:DatatypeProperty ;
    rdfs:domain mx:Concept ;
    rdfs:range xsd:string .

mx:lambda a owl:DatatypeProperty ;
    rdfs:domain mx:LevelSCW ;
    rdfs:range xsd:decimal .

mx:lensRank a owl:DatatypeProperty ;
    rdfs:domain mx:DriftSCW ;
    rdfs:range xsd:integer .

mx:level a owl:DatatypeProperty ;
    rdfs:domain mx:LevelSCW ;
    rdfs:range xsd:string .

mx:listsServer a owl:ObjectProperty ;
    rdfs:domain mx:Topic ;
    rdfs:range mx:MCPServer .

mx:memoryType a owl:DatatypeProperty ;
    rdfs:domain mx:Skill ;
    rdfs:range xsd:string .

mx:priority a owl:DatatypeProperty ;
    rdfs:domain mx:Topic ;
    rdfs:range xsd:integer .

mx:psi a owl:DatatypeProperty ;
    rdfs:domain mx:DriftSCW ;
    rdfs:range xsd:decimal .

mx:relA a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain mx:ConceptRelation ;
    rdfs:range mx:Concept .

mx:relB a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain mx:ConceptRelation ;
    rdfs:range mx:Concept .

mx:relatedConcept a owl:IrreflexiveProperty,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:domain mx:Concept ;
    rdfs:range mx:Concept .

mx:remainingTask a owl:DatatypeProperty ;
    rdfs:domain mx:PathSCW ;
    rdfs:range xsd:decimal .

mx:score a owl:DatatypeProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:decimal .

mx:servesSkill a owl:ObjectProperty ;
    owl:inverseOf mx:hasAgent .

mx:sourceUrl a owl:DatatypeProperty ;
    rdfs:domain mx:MCPServer ;
    rdfs:range xsd:string .

mx:state a owl:DatatypeProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

mx:task a owl:DatatypeProperty ;
    rdfs:domain mx:PathSCW ;
    rdfs:range xsd:string .

mx:taskIn a owl:DatatypeProperty ;
    rdfs:domain mx:LevelSCW ;
    rdfs:range xsd:decimal .

mx:taskOut a owl:DatatypeProperty ;
    rdfs:domain mx:LevelSCW ;
    rdfs:range xsd:decimal .

mx:toolName a owl:DatatypeProperty ;
    rdfs:domain mx:MCPServer ;
    rdfs:range xsd:string .

mx:totalDrift a owl:DatatypeProperty ;
    rdfs:domain mx:PathSCW ;
    rdfs:range xsd:decimal .

mx:viaPrimary a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain mx:Gate ;
    rdfs:range mx:Agent .

mx:viaSkill a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:domain mx:Gate ;
    rdfs:range mx:Skill .

mx:weight a owl:DatatypeProperty ;
    rdfs:domain mx:DriftSCW ;
    rdfs:range xsd:decimal .

