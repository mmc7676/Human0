    rdfs:domain mx:Skill ;
    rdfs:range mx:Agent ;
    rdfs:subPropertyOf mx:hasAgent .

mx:hasPrimaryAgent a owl:ObjectProperty ;
    rdfs:domain mx:Skill ;
    rdfs:range mx:Agent ;
    rdfs:subPropertyOf mx:hasAgent .

mx:holdsServer a owl:ObjectProperty ;
    rdfs:domain mx:Agent ;
    rdfs:range mx:MCPServer .

