mx:Topic a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass mx:Domain ;
            owl:onProperty mx:inDomain ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

mx:Gate a owl:Class .

mx:Concept a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass mx:Topic ;
            owl:onProperty mx:inTopic ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

mx:Agent a owl:Class .

mx:Skill a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass mx:Agent ;
            owl:onProperty mx:hasPrimaryAgent ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass mx:Agent ;
            owl:onProperty mx:hasCheckerAgent ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass mx:Concept ;
            owl:onProperty mx:inConcept ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] .

[] a owl:AllDisjointClasses ;
    owl:members ( mx:Domain mx:Topic mx:Concept mx:Skill mx:Agent mx:MCPServer mx:Gate mx:ConceptRelation ) .

